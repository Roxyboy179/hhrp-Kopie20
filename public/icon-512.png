<?xml version="1.0" encoding="UTF-8"?>
<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:rgba(255,255,255,0.08)"/>
      <stop offset="100%" style="stop-color:rgba(255,255,255,0)"/>
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" fill="#050505"/>
  
  <!-- Glow -->
  <rect width="512" height="512" fill="url(#glow)"/>
  
  <!-- Glass Card -->
  <rect x="102.4" y="102.4" width="307.2" height="307.2" 
        rx="76.8" fill="rgba(255,255,255,0.08)" 
        stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
  
  <!-- Letter H -->
  <text x="50%" y="50%" font-family="Arial, sans-serif" font-size="179.2" 
        font-weight="bold" fill="#ffffff" text-anchor="middle" dominant-baseline="central">H</text>
</svg>